# ==============================================================================
# BOLBASH BEAUTY SPOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Django Core Security & Settings
SECRET_KEY=your_strong_random_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.onrender.com,www.bolbashbeautyspot.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://www.bolbashbeautyspot.com

# Production SSL & Cookie Security (Enabled when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database Configuration (MySQL)
# Option A: Connection URL (Recommended for Cloud Hosting / Render)
DATABASE_URL=mysql://username:password@host:port/database_name

# Option B: Individual MySQL Parameters (Local Development)
DB_ENGINE=django.db.backends.mysql
DB_NAME=bolbash_beautyspot_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Paystack Payment Gateway (Live or Test Credentials)
PAYSTACK_PUBLIC_KEY=pk_test_45ac4546609405d68991dc72b77ba25649bd8103
PAYSTACK_SECRET_KEY=sk_test_c39ac295aa0b82515f36239b3c7cae9dda5cb2a9
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Official Business Settlement Account Details
PAYSTACK_BANK_NAME=OPay
PAYSTACK_ACCOUNT_NUMBER=8148281423
PAYSTACK_ACCOUNT_NAME=Lukexx Business And Technology

# Booking Deposit Rules
BOOKING_DEPOSIT_AMOUNT=100.00

# Email Notification Service (SMTP)
